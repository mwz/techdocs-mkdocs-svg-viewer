{
  "name": "@mwz/techdocs-mkdocs-svg-viewer",
  "version": "0.2.0",
  "description": "Accessible full-window pan and zoom for inline SVG diagrams in Backstage TechDocs and MkDocs sites",
  "keywords": [
    "backstage",
    "techdocs",
    "mkdocs",
    "svg",
    "diagram",
    "pan-zoom"
  ],
  "license": "Apache-2.0",
  "author": "Michael Wizner",
  "homepage": "https://github.com/mwz/techdocs-mkdocs-svg-viewer#readme",
  "bugs": {
    "url": "https://github.com/mwz/techdocs-mkdocs-svg-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwz/techdocs-mkdocs-svg-viewer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./alpha": {
      "types": "./dist/alpha.d.ts",
      "import": "./dist/alpha.js",
      "require": "./dist/alpha.cjs"
    },
    "./viewer": {
      "types": "./dist/viewer/index.d.ts",
      "import": "./dist/viewer/index.js",
      "require": "./dist/viewer/index.cjs"
    },
    "./svg-viewer.js": "./dist/svg-viewer.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/svg-viewer.js"
  ],
  "backstage": {
    "role": "frontend-plugin-module",
    "pluginId": "techdocs",
    "pluginPackage": "@backstage/plugin-techdocs",
    "features": {
      "./alpha": "@backstage/FrontendModule"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test",
    "dev": "vite --host 127.0.0.1",
    "check": "pnpm typecheck && pnpm test && pnpm test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build",
    "example:standalone:dev": "pnpm build && vite --host 127.0.0.1 --port 5174 --strictPort --open /examples/standalone/",
    "example:standalone:test": "pnpm build && playwright test tests/browser/standalone.spec.ts",
    "example:mkdocs:prepare": "pnpm build && node -e \"fs.mkdirSync('examples/mkdocs/docs/javascripts',{recursive:true});fs.copyFileSync('dist/svg-viewer.js','examples/mkdocs/docs/javascripts/svg-viewer.js')\"",
    "example:mkdocs:dev": "pnpm example:mkdocs:prepare && cd examples/mkdocs && poetry install && poetry run mkdocs serve",
    "example:mkdocs:test": "cd examples/mkdocs && poetry run python -m unittest discover -s tests",
    "example:backstage:prepare": "pnpm example:mkdocs:prepare && node examples/backstage/scripts/prepare.mjs",
    "example:backstage:setup": "pnpm example:backstage:prepare && cd examples/mkdocs && poetry install && cd ../backstage && yarn install --immutable",
    "example:backstage:dev": "pnpm example:backstage:prepare && node examples/backstage/scripts/start.mjs",
    "example:backstage:check": "cd examples/backstage && yarn typecheck && yarn config:check && yarn build:app",
    "example:backstage:test": "playwright test --config examples/backstage/playwright.config.ts"
  },
  "peerDependencies": {
    "@backstage/core-plugin-api": "^1.12.11",
    "@backstage/frontend-plugin-api": "^0.18.2",
    "@backstage/plugin-techdocs-react": "^1.4.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@backstage/core-plugin-api": {
      "optional": true
    },
    "@backstage/frontend-plugin-api": {
      "optional": true
    },
    "@backstage/plugin-techdocs-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@backstage/core-plugin-api": "1.12.11",
    "@backstage/frontend-plugin-api": "0.18.2",
    "@backstage/plugin-techdocs-react": "1.4.0",
    "@playwright/test": "1.60.0",
    "@techdocs/cli": "^1.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "prettier": "^3.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
