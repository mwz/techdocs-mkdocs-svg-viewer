{
  "name": "@mwz/backstage-techdocs-addon-svg-viewer",
  "version": "0.1.0",
  "description": "Accessible fullscreen pan and zoom for inline SVG diagrams in Backstage TechDocs",
  "private": true,
  "license": "UNLICENSED",
  "author": "Michael Wizner",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwz/backstage-techdocs-addon-svg-viewer.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./alpha": {
      "types": "./dist/alpha.d.ts",
      "import": "./dist/alpha.js",
      "require": "./dist/alpha.cjs"
    },
    "./viewer": {
      "types": "./dist/viewer/index.d.ts",
      "import": "./dist/viewer/index.js",
      "require": "./dist/viewer/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "techdocs-addon-svg-viewer"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@backstage/core-plugin-api": "^1.12.11",
    "@backstage/frontend-plugin-api": "^0.18.2",
    "@backstage/plugin-techdocs-react": "^1.4.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@backstage/frontend-plugin-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@backstage/core-plugin-api": "1.12.11",
    "@backstage/frontend-plugin-api": "0.18.2",
    "@backstage/plugin-techdocs-react": "1.4.0",
    "@playwright/test": "1.60.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "prettier": "^3.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
